# =========================================================
# Devspherex Nest Admin API — environment template
# Copy this file to `.env` and adjust values for your setup.
# Never commit the real `.env`. The real `.env` is in .gitignore.
# =========================================================

# ---------------------------------------------------------
# Database
# ---------------------------------------------------------
DATABASE_URL="postgresql://postgres:PostgreSQL123@localhost:5432/temp?schema=public"

# ---------------------------------------------------------
# JWT
# ---------------------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------
# Password Recovery
# ---------------------------------------------------------
# Master switch. When false, all three recovery endpoints
# (forgot-password, verify-password-recovery-otp, reset-password)
# return a generic "not available" message.
PASSWORD_RECOVERY_ENABLED=true

# Which channel is used to deliver the OTP. Allowed values:
#   NOOP     - silently discards (useful for tests)
#   CONSOLE  - logs the OTP to server stdout (dev/staging ONLY)
#   EMAIL    - reserved for a future real email provider
#   WHATSAPP - reserved for a future WhatsApp provider
#   SMS      - reserved for a future SMS provider
#
# In production, if PASSWORD_RECOVERY_ENABLED=true, the configured
# channel MUST be one of EMAIL / WHATSAPP / SMS (a real provider
# you have implemented). CONSOLE/NOOP are refused by the boot guard
# in that case. To disable recovery in production, set
# PASSWORD_RECOVERY_ENABLED=false.
PASSWORD_RECOVERY_CHANNEL=CONSOLE

# OTP code length in digits. Range: 4..10. Default: 6.
PASSWORD_RECOVERY_OTP_LENGTH=6

# OTP validity window in seconds. Range: 30..3600. Default: 300 (5 min).
PASSWORD_RECOVERY_OTP_TTL_SECONDS=300

# Reset session token validity window in seconds.
# Range: 60..3600. Default: 600 (10 min).
PASSWORD_RECOVERY_RESET_TOKEN_TTL_SECONDS=600

# Minimum time between two consecutive recovery requests for the
# same email address (enforced per emailHash; works for both
# known and unknown emails).
# Range: 0..3600. Default: 60 (1 min). Set to 0 to disable.
PASSWORD_RECOVERY_RESEND_COOLDOWN_SECONDS=60

# Maximum failed OTP verification attempts before the challenge
# is revoked. Range: 1..20. Default: 5.
PASSWORD_RECOVERY_MAX_VERIFY_ATTEMPTS=5

# When true (default), a successful password reset revokes all
# refresh tokens and increments the user's tokenVersion,
# invalidating active access tokens.
PASSWORD_RECOVERY_REVOKE_SESSIONS_ON_SUCCESS=true

# Server-side pepper used to HMAC emails, OTPs, and reset tokens.
# MUST be overridden in production (when PASSWORD_RECOVERY_ENABLED=true)
# to a strong, non-default value of at least 16 characters.
# The boot guard refuses to start the app if the pepper is a known
# weak default or too short while recovery is enabled in production.
PASSWORD_RECOVERY_PEPPER=change-me-in-local-dev-only

# Dev-only: when true, the OTP is included in the forgot-password
# response so integration tests can pick it up.
# MUST be false in production. The boot guard refuses to start the
# app if this is true in production.
PASSWORD_RECOVERY_DEV_RETURN_OTP=false
